# Google Sheets (Adelskalender / Clubrecords)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# Brevo (transactionele e-mail voor contact-, proefzwem- en lidmaatschapsformulier)
# Zie BREVO_SETUP.md voor stap-voor-stap instructies.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@zvdbs.nl
BREVO_SENDER_NAME=ZVDBS website

# Optioneel: ontvanger-adres voor formulieren (standaard secretaris@zvdbs.nl)
CONTACT_TO_EMAIL=secretaris@zvdbs.nl
MEMBERSHIP_TO_EMAIL=secretaris@zvdbs.nl

# Environment
NODE_ENV=development
